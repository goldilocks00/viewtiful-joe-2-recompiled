+unsigned BuildJobs()
+{
+  if (const char* text = std::getenv("CMAKE_BUILD_PARALLEL_LEVEL"))
+  {
+    const std::string_view value(text);
+    unsigned jobs = 0;
+    const auto result = std::from_chars(value.data(), value.data() + value.size(), jobs);
+    if (result.ec != std::errc{} || result.ptr != value.data() + value.size() || jobs == 0)
+    {
+      std::cerr << "CMAKE_BUILD_PARALLEL_LEVEL must be a positive integer\n";
+      std::exit(2);
+    }
+    return jobs;
+  }
+  return std::max(1u, std::thread::hardware_concurrency());
+}
